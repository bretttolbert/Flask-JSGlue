{
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.formatOnSave": true,
        "editor.wordBasedSuggestions": "off",
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "black-formatter.args": ["--line-length", "120"],
    "python.analysis.extraPaths": [],
    "python.autoComplete.extraPaths": [],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["-vv"],
    "files.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/reports": true,
        "**/data": true,
        "**/build": true,
        "**/.env": true,
        "**/.envrc": true,
        "**/.venv": true,
        "**/.mypy_cache": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.venv*": true,
        "**/env/": true,
        "**/venv/": true,
        "**/ENV/": true,
        "**/env.bak/": true,
        "**/venv.bak/": true,
        "**/*.egg-info": true,
        "**/dist": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/reports": true,
        "**/data": true,
        "**/build": true,
        "**/.env": true,
        "**/.envrc": true,
        "**/.venv": true,
        "**/.mypy_cache": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.venv*": true,
        "**/env/": true,
        "**/venv/": true,
        "**/ENV/": true,
        "**/env.bak/": true,
        "**/venv.bak/": true,
        "**/*.egg-info": true,
        "**/dist": true
    }
}